# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SMART_MASAR_ADMIN_KEY: Server-side administrator secret key for protected writes & image uploads.
SMART_MASAR_ADMIN_KEY="sm_masar_admin_secret_2026"

# SHEETDB_API_URL: SheetDB endpoint connected to the Smart Masar Google Spreadsheet.
SHEETDB_API_URL="https://sheetdb.io/api/v1/gnn52l70oflrp"

# GOOGLE_APPS_SCRIPT_URL: Deployed Google Apps Script Web App URL for Google Drive uploads & Sheets sync.
GOOGLE_APPS_SCRIPT_URL=""

# GOOGLE_DRIVE_FOLDER_ID: Dedicated Google Drive folder ID for storing uploaded images.
GOOGLE_DRIVE_FOLDER_ID=""
